# Copier ce fichier en .env et renseigner l'URI MongoDB Atlas
MONGODB_URI=mongodb+srv://<utilisateur>:<mot_de_passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_NAME=mediconnect
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# En production (Railway) : DJANGO_ENV=production, DJANGO_DEBUG=False et une vraie clé secrète (le serveur refuse sinon).
# DJANGO_ENV=production
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mediconnect.vercel.app

# --- Tests automatisés ---
# Les tests créent leur propre base sur ce serveur MongoDB (jamais sur le cluster Atlas) : MongoDB local par défaut.
# MONGODB_TEST_URI=mongodb://localhost:27017

# --- Celery et Redis (facultatif) ---
# Avec Redis : e-mails et analyses IA longues en tâche de fond (worker : celery -A mediconnect worker -l info).
# Sans REDIS_URL, tout s'exécute dans la requête, comme avant.
# REDIS_URL=redis://localhost:6379/0

# --- Sécurité des connexions ---
# CONNEXION_ESSAIS_MAX=5          # échecs avant blocage d'un identifiant
# CONNEXION_BLOCAGE_MINUTES=15
# SESSION_DUREE_HEURES=8

# --- Intelligence artificielle (facultatif) ---
# Gratuit : créer un compte sur https://console.groq.com puis une clé d'API, et la coller ici (jamais dans Git).
# IA_FOURNISSEUR=groq      # aucun (défaut) | groq (cloud) | ollama (local, voir README)
# GROQ_API_KEY=
# IA_MODELE=               # vide = modèle par défaut du fournisseur (qwen/qwen3.8-27b pour Groq)
# IA_DELAI_MAX=6           # secondes avant de revenir aux règles


# --- E-mail : « mot de passe oublié » et rendez-vous confirmé ou annulé (facultatif) ---
# Exemple Gmail : EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True, mot de passe d'application (jamais le vrai mot de passe).
# Sans rien changer, le lien de réinitialisation s'affiche dans la console du serveur (développement).
# Gmail ou Google Workspace : smtp.gmail.com, port 587, TLS.
# EMAIL_HOST_PASSWORD est un mot de passe d'application (compte Google, sécurité).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=MediConnect <no-reply@exemple.tn>
# Compte propre aux comptes rendus PDF des médecins (facultatif, sinon le compte ci-dessus) :
# MEDECINS_EMAIL_HOST_USER=
# MEDECINS_EMAIL_HOST_PASSWORD=
# MEDECINS_DEFAULT_FROM_EMAIL=MediConnect <medecins@exemple.tn>

# --- SMS (facultatif) ---
# Sans compte Twilio, le clic du médecin ouvre l'application SMS du téléphone.
# Le jeton du compte prime sur la clé API. Le service de messagerie prime sur le numéro expéditeur.
# SMS_MODE=twilio
# SMS_NUMERO_TEST=+21600000000
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=

# --- WhatsApp (compte rendu au clic du médecin) ---
# Jeton et identifiant du numéro : Meta for Developers, cas d'utilisation WhatsApp, étape 1.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_FROM=
# WHATSAPP_PIN=
